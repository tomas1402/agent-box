def leer_nodos() -> list[dict]:
    if not NODOS_JSON.exists():
        raise BoxError("config_invalida", f"falta {NODOS_JSON} (ver config/nodos.json.example)")
    return json.loads(NODOS_JSON.read_text())["nodos"]


def nodo(nombre: str) -> dict:
    for n in leer_nodos():
        if n["nombre"] == nombre:
            return n
    raise BoxError("nodo_desconocido", f"nodo desconocido: {nombre}")


def remoto(n: dict, argv: list[str]) -> dict:
    """Corre boxctl --json en el nodo y devuelve el sobre JSON. Propaga el error remoto."""
    cmd = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", n["ssh"],
           "sudo /usr/local/bin/boxctl --json " + " ".join(shlex.quote(x) for x in argv)]
    r = sh(cmd, timeout=int(n.get("timeout", 120)))
    if r.returncode == 255:
        raise BoxError("nodo_inalcanzable", f"ssh {n['ssh']} fallo", {"stderr": r.stderr.strip()[-300:]})
    if not r.stdout.strip() and (r.returncode == 127 or "not found" in r.stderr or "no such file" in r.stderr.lower()):
        raise BoxError("dependencia_faltante", f"boxctl no esta instalado en {n['nombre']} (install.sh)",
                       {"stderr": r.stderr.strip()[-300:]})
    try:
        sobre = json.loads(r.stdout)
    except ValueError:
        raise BoxError("error_interno", f"respuesta no JSON de {n['nombre']}", {"salida": r.stdout[-300:]})
    if not sobre.get("ok"):
        e = sobre.get("error", {})
        raise BoxError(e.get("codigo", "error_interno") if e.get("codigo") in ERRORES else "error_interno",
                       f"[{n['nombre']}] {e.get('mensaje', '')}", e.get("detalle"))
    return sobre["datos"]


def orca(*args: str, timeout: int = 120) -> dict:
    r = sh([os.environ.get("ORCA_BIN", "orca"), *args, "--json"], timeout=timeout)
    if r.returncode:
        raise BoxError("error_interno", f"orca {' '.join(args[:2])} fallo: {(r.stderr or r.stdout).strip()[:300]}")
    d = json.loads(r.stdout or "{}")
    return d.get("result", d)


def op_nodos(_a) -> dict:
    out = []
    for n in leer_nodos():
        fila = {"nombre": n["nombre"], "habilitado": n.get("habilitado", True), "orcaEnvironment": n["orcaEnvironment"]}
        if fila["habilitado"]:
            try:
                fila["estado"] = remoto(n, ["estado"])
                fila["alcanzable"] = True
            except BoxError as e:
                fila.update(alcanzable=False, error={"codigo": e.codigo, "mensaje": e.mensaje})
        out.append(fila)
    return {"nodos": out}


def elegir_nodo(nodos: list[dict]) -> dict:
    cand = [n for n in nodos if n.get("alcanzable") and n["estado"]["capacidad"]["workersCaben"] > 0]
    if not cand:
        raise BoxError("capacidad_insuficiente", "ningun nodo tiene lugar para un worker mas",
                       {"nodos": [{"nombre": n["nombre"], "capacidad": (n.get("estado") or {}).get("capacidad")}
                                  for n in nodos]})
    cand.sort(key=lambda n: (-n["estado"]["capacidad"]["workersCaben"],
                             -n["estado"]["capacidad"]["suitesCaben"], n["nombre"]))
    return cand[0]


def _worktrees(env: str) -> list[dict]:
    r = orca("worktree", "ps", "--environment", env)
    items = r.get("worktrees") if isinstance(r, dict) else r
    return items or []


def iso_de_epoch(ts) -> str:
    if not isinstance(ts, (int, float)) or ts <= 0:
        return ""
    if ts > 10**12:
        ts = ts / 1000
    return _dt.datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M")


def seguimiento_de(w: dict) -> str:
    partes = []
    issue = w.get("linkedIssue")
    if isinstance(issue, dict):
        partes.append(issue.get("title") or issue.get("identifier") or issue.get("url") or "")
    elif isinstance(issue, str):
        partes.append(issue)
    pr = w.get("linkedPR")
    if isinstance(pr, dict):
        partes.append(pr.get("title") or pr.get("url") or "")
    elif isinstance(pr, str):
        partes.append(pr)
    for it in w.get("linkedItems") or []:
        if isinstance(it, dict):
            partes.append(it.get("title") or it.get("url") or "")
        elif isinstance(it, str):
            partes.append(it)
    comentario = (w.get("comment") or "").strip()
    if comentario:
        partes.append(comentario)
    partes = [p for p in partes if p]
    return " · ".join(partes) if partes else "sin seguimiento"


def proyectar_worktree(w: dict) -> dict:
    """Fila estable. Orca manda worktreeId, branch con refs/heads y lastActivityAt en ms.
    worker lista antes leia id y agents, que este JSON no trae, y la fila salia vacia."""
    rama = w.get("branch") or ""
    if rama.startswith("refs/heads/"):
        rama = rama[len("refs/heads/"):]
    agentes = [ag.get("state") for ag in (w.get("agents") or []) if isinstance(ag, dict)]
    return {
        "id": w.get("id") or w.get("worktreeId"),
        "path": w.get("path") or "",
        "rama": rama,
        "agentes": agentes,
        "repo": w.get("repo") or "",
        "nombre": w.get("displayName") or "",
        "estado": w.get("workspaceStatus") or "",
        "host": w.get("hostId") or "",
        "terminales": int(w.get("liveTerminalCount") or 0),
        "actividad": iso_de_epoch(w.get("lastActivityAt")),
        "seguimiento": seguimiento_de(w),
        "sinLeer": bool(w.get("unread")),
        "archivado": bool(w.get("isArchived")),
        "esPrincipal": bool(w.get("isMainWorktree")),
    }


def dir_reloj(explicito: str = "") -> Path:
    if explicito:
        return Path(explicito)
    env = os.environ.get("AGENT_BOX_ESTADO", "")
    if env:
        return Path(env)
    return Path.home() / ".local" / "share" / "agent-box" / "wi"


def leer_reloj(directorio: Path) -> tuple[list[dict], list[str]]:
    if not directorio.is_dir():
        return [], [f"no hay estado de boxd en {directorio}"]
    filas, avisos = [], []
    for p in sorted(directorio.glob("*.json")):
        try:
            w = json.loads(p.read_text())
        except (OSError, ValueError) as e:
            avisos.append(f"{p.name}: {e}")
            continue
        if not isinstance(w, dict) or not w.get("id"):
            avisos.append(f"{p.name}: no es un WI")
            continue
        tracker = w.get("tracker") if isinstance(w.get("tracker"), dict) else {}
        act = w.get("actividad") if isinstance(w.get("actividad"), dict) else {}
        corrida = w.get("corrida") if isinstance(w.get("corrida"), dict) else None
        filas.append({
            "id": w.get("id"),
            "fase": w.get("fase") or "",
            # En que esta la caja ahora: la escribe boxd, no el agente.
            "etapa": act.get("etapa") or "",
            "detalle": act.get("detalle") or "",
            "desde": act.get("desde") or "",
            "ultimoCambio": act.get("ultimoCambio") or "",
            "archivos": act.get("archivos") or {},
            "corrida": corrida and {
                "tipo": corrida.get("tipo") or "", "codigo": corrida.get("codigo") or "",
                "inicio": corrida.get("inicio") or "", "ms": corrida.get("ms") or 0,
                "gates": [{"nombre": g.get("nombre"), "verde": bool(g.get("verde")), "ms": g.get("ms") or 0}
                          for g in (corrida.get("gates") or []) if isinstance(g, dict)],
            },
            "fallosSeguidos": int(w.get("fallosSeguidos") or 0),
            "repo": tracker.get("repo") or "",
            "worktree": w.get("worktree") or "",
            "ultimoGate": w.get("ultimoGate") or "",
            "esperando": w.get("esperando") or [],
            "huecos": w.get("huecos") or [],
            "actualizado": w.get("actualizado") or "",
        })
    return filas, avisos


def en_curso(filas: list[dict]) -> list[dict]:
    """El clon principal quieto no es trabajo. Si tiene una terminal viva, entra."""
    vivas = [f for f in filas if not f["archivado"] and (not f["esPrincipal"] or f["terminales"] > 0)]
    vivas.sort(key=lambda f: (f["terminales"], f["actividad"]), reverse=True)
    return vivas


def partir_sesiones(filas: list[dict]) -> tuple[list[dict], list[dict]]:
    """Con terminal es lo que se está trabajando. El resto son worktrees que Orca
    sigue marcando in-progress aunque nadie esté adentro."""
    vivas = en_curso(filas)
    return ([f for f in vivas if f["terminales"] > 0], [f for f in vivas if f["terminales"] == 0])


def armar_panel(estado: Path | None = None, remotos: "NodosDeFondo | None" = None, con_metricas: bool = False) -> dict:
    avisos: list[str] = []
    sesiones: list[dict] = []
    try:
        r = orca("worktree", "ps", "--limit", "200", timeout=20)
        items = r.get("worktrees") if isinstance(r, dict) else r
        sesiones, abiertos = partir_sesiones(
            [proyectar_worktree(w) for w in (items or []) if isinstance(w, dict)])
    except BoxError as e:
        avisos.append(e.mensaje)
        sesiones, abiertos = [], []
    reloj, extra = leer_reloj(estado or dir_reloj())
    avisos.extend(extra)
    # La caja y la sesion de Orca se juntan por el path del worktree.
    por_path = {os.path.realpath(w["worktree"]): w for w in reloj if w["worktree"]}
    for s in sesiones + abiertos:
        w = por_path.get(os.path.realpath(s["path"])) if s["path"] else None
        s["caja"] = {"wi": w["id"], "fase": w["fase"], "etapa": w["etapa"]} if w else None
        if w:
            w["sesion"] = {"nombre": s["nombre"], "rama": s["rama"], "host": s["host"], "terminales": s["terminales"]}
    cajas, nodos = [], []
    if con_metricas:
        cajas, local = cajas_locales(estado or dir_reloj())
        nodos = [local]
        if remotos:
            cr, nr = remotos.foto()
            cajas, nodos = cajas + cr, nodos + nr
        nombres = {os.path.realpath(s["path"]): s["nombre"] for s in sesiones + abiertos if s["path"]}
        for c in cajas:
            c["sesion"] = nombres.get(os.path.realpath(c.get("worktree") or "")) if c["nodo"] == "mac" else None
    return {
        "ts": _dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "sesiones": sesiones,
        "abiertos": abiertos,
        "reloj": reloj,
        "cajas": cajas,
        "nodos": nodos,
        "avisos": avisos,
    }


HTML_PANEL = Path(__file__).resolve().parent.parent / "panel" / "index.html"


def boxd_local() -> str | None:
    # Primero el que se compilo en este repo (make build): es el que corresponde a este panel.
    del_repo = Path(__file__).resolve().parent.parent / "bin" / "boxd"
    return os.environ.get("BOXD_BIN") or next(
        (str(p) for p in [del_repo, Path.home() / ".local/bin/boxd"] if p.exists()), None) or shutil.which("boxd")


def _cajas_de(salida: str, nodo_nombre: str) -> tuple[list[dict], dict]:
    datos = (json.loads(salida) or {}).get("datos") or {}
    cajas = datos.get("cajas") or []
    for c in cajas:
        c["nodo"] = nodo_nombre
        c["eventos"] = (c.get("eventos") or [])[-14:]
        # Lo que el panel no usa y pesa: comandos, baseline, pines.
        for k in ("gates", "baseline", "viajes", "setup"):
            c.pop(k, None)
    return cajas, (datos.get("nodo") or {})


def cajas_locales(estado: Path) -> tuple[list[dict], dict]:
    """Cajas de esta maquina, con etapa al dia y RAM/CPU. Sin boxd, lo que diga el archivo."""
    b = boxd_local()
    if not b:
        return [], {"nombre": "mac", "alcanzable": False, "error": "no encuentro boxd"}
    r = sh([b, "--json", "--estado-dir", str(estado), "lista", "--observar", "--metricas"], timeout=25)
    try:
        cajas, n = _cajas_de(r.stdout, "mac")
    except ValueError:
        return [], {"nombre": "mac", "alcanzable": False, "error": (r.stderr or "boxd no respondio").strip()[:200]}
    # En la Mac el presupuesto es la RAM de la VM de Docker, no el perfil de un nodo.
    n.update(nombre="mac", alcanzable=True, presupuestoMb=None)
    return cajas, n


def cajas_de_nodo(n: dict) -> tuple[list[dict], dict]:
    perfil = n.get("perfil") or n["nombre"]  # perfil de memoria que entiende boxd (--nodo)
    r = sh(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=8", n["ssh"], "sudo", "boxd", "--json",
            "--estado-dir", "/var/lib/agent-box/wi", "--nodo", perfil, "lista", "--observar", "--metricas"], timeout=30)
    try:
        cajas, info = _cajas_de(r.stdout, n["nombre"])
    except ValueError:
        return [], {"nombre": n["nombre"], "alcanzable": False,
                    "error": "sin respuesta por ssh" if r.returncode == 255 else "boxd no respondio"}
    info.update(nombre=n["nombre"], alcanzable=True)
    return cajas, info


class NodosDeFondo:
    """Los nodos se consultan por ssh en un hilo aparte: el panel no espera a ningun nodo."""

    def __init__(self, cada: float = 15.0):
        import threading
        self.cada, self.traba = cada, threading.Lock()
        self.cajas: list[dict] = []
        self.nodos: list[dict] = []
        self.hilo = threading.Thread(target=self._girar, daemon=True)

    def arrancar(self):
        self.hilo.start()
        return self

    def _girar(self):
        from concurrent.futures import ThreadPoolExecutor
        while True:
            try:
                nodos = [n for n in leer_nodos() if n.get("habilitado", True)]
            except (BoxError, OSError, ValueError):
                nodos = []
            if nodos:
                with ThreadPoolExecutor(max_workers=len(nodos)) as ex:
                    res = list(ex.map(cajas_de_nodo, nodos))
                with self.traba:
                    self.cajas = [c for cs, _ in res for c in cs]
                    self.nodos = [info for _, info in res]
            time.sleep(self.cada)

    def foto(self) -> tuple[list[dict], list[dict]]:
        with self.traba:
            return list(self.cajas), list(self.nodos)


def panel_httpd(armar, puerto: int):
    from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):  # noqa: N802 - firma de http.server
            if self.path.split("?", 1)[0] == "/api/panel":
                body = json.dumps(armar(), ensure_ascii=False).encode()
                tipo = "application/json; charset=utf-8"
            elif self.path.split("?", 1)[0] in ("/", "/index.html"):
                body = HTML_PANEL.read_bytes()
                tipo = "text/html; charset=utf-8"
            else:
                self.send_error(404)
                return
            self.send_response(200)
            self.send_header("Content-Type", tipo)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, fmt, *args):
            return

    return ThreadingHTTPServer(("127.0.0.1", puerto), Handler)


def con_cache(armar, segundos: float = 3.0):
    """Varias pestañas abiertas piden lo mismo: se arma una vez cada `segundos`."""
    import threading
    traba, guardado = threading.Lock(), {"t": 0.0, "datos": None}

    def leer():
        with traba:
            if guardado["datos"] is None or time.monotonic() - guardado["t"] > segundos:
                guardado["datos"], guardado["t"] = armar(), time.monotonic()
            return guardado["datos"]
    return leer


def servir_panel(armar, puerto: int) -> None:
    httpd = panel_httpd(con_cache(armar), puerto)
    host, port = httpd.server_address
    print(f"panel en http://{host}:{port}", flush=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        httpd.server_close()


def op_panel(a) -> dict:
    estado = dir_reloj(a.estado_dir)
    if a.servir:
        remotos = NodosDeFondo().arrancar()
        servir_panel(lambda: armar_panel(estado, remotos, con_metricas=True), a.puerto)
    return armar_panel(estado, con_metricas=True)


def op_worker(a) -> dict:
    if a.accion == "lista":
        out = []
        for n in leer_nodos():
            if not n.get("habilitado", True):
                continue
            for w in _worktrees(n["orcaEnvironment"]):
                fila = proyectar_worktree(w)
                fila["nodo"] = n["nombre"]
                out.append(fila)
        return {"workers": out}

    if a.accion == "alta":
        if a.nodo in (None, "auto"):
            elegido = elegir_nodo(op_nodos(a)["nodos"])
        else:
            n = nodo(a.nodo)
            est = remoto(n, ["estado"])
            if est["capacidad"]["workersCaben"] <= 0:
                raise BoxError("capacidad_insuficiente", f"{n['nombre']} sin lugar", {"capacidad": est["capacidad"]})
            elegido = {**n, "estado": est}
        env = elegido["orcaEnvironment"]
        plan = {"nodo": elegido["nombre"], "environment": env, "repo": a.repo, "rama": a.rama,
                "base": a.base, "wi": a.wi, "capacidad": elegido["estado"]["capacidad"], "aplicado": False}
        if not a.aplicar:
            return plan
        repos = {r["displayName"]: r["id"] for r in orca("repo", "list", "--environment", env)["repos"]}
        if a.repo not in repos:
            raise BoxError("repo_no_registrado", f"{a.repo} no esta registrado en el orcad de {env}",
                           {"registrados": sorted(repos)})
        w = orca("worktree", "create", "--environment", env, "--repo", f"id:{repos[a.repo]}", "--name", a.rama,
                 "--no-parent", "--setup", "skip", "--base-branch", a.base, timeout=300)["worktree"]
        plan.update(aplicado=True, worktree={"id": w.get("id"), "path": w.get("path"), "rama": w.get("branch")})
        return plan

    # baja
    n = nodo(a.nodo) if a.nodo not in (None, "auto") else None
    if n is None:
        raise BoxError("operacion_invalida", "worker baja exige --nodo")
    match = [w for w in _worktrees(n["orcaEnvironment"])
             if a.worktree in (w.get("id"), w.get("worktreeId"), w.get("path"))]
    if not match:
        raise BoxError("worker_no_existe", f"{a.worktree} no existe en {n['nombre']}")
    w = match[0]
    vivos = [ag.get("state") for ag in (w.get("agents") or []) if ag.get("state") in ("working", "waiting", "blocked")]
    if vivos and not a.forzar:
        raise BoxError("worker_activo", "el worktree tiene agentes vivos", {"agentes": vivos})
    res = {"nodo": n["nombre"], "worktree": w.get("path"), "aplicado": False}
    if not a.forzar:
        fila = next((it for it in remoto(n, ["limpiar"])["worktrees"] if it["path"] == w.get("path")), None)
        if fila and (fila.get("sucios") or fila.get("sinPush")):
            raise BoxError("worker_sucio", "el worktree tiene trabajo sin commitear o sin pushear; "
                           "boxctl salvar --aplicar primero, o --forzar con OK de quien opera",
                           {"sucios": fila.get("sucios"), "sinPush": fila.get("sinPush")})
        res["balde"] = fila.get("balde") if fila else None
    if a.aplicar:
        orca("worktree", "rm", "--worktree", f"path:{w.get('path')}", "--environment", n["orcaEnvironment"])
        res["aplicado"] = True
    return res


def limpiar_desde_mac(a) -> dict:
    """limpiar --aplicar desde la Mac: los worktrees de Orca se borran con orca (si no, se desincroniza)."""
    n = nodo(a.nodo)
    d = remoto(n, ["limpiar"])
    if not a.aplicar:
        return d
    conocidos = {w.get("path") for w in _worktrees(n["orcaEnvironment"])}
    podados, fallos = [], []
    for it in d["worktrees"]:
        if it["balde"] != "seguro":
            continue
        try:
            if it["path"] in conocidos:
                orca("worktree", "rm", "--worktree", f"path:{it['path']}", "--environment", n["orcaEnvironment"])
            else:
                remoto(n, ["podar", it["path"]])
            podados.append(it["path"])
        except BoxError as e:
            fallos.append({"path": it["path"], "codigo": e.codigo, "mensaje": e.mensaje})
    return {**d, "aplicado": True, "podados": podados, "fallos": fallos}


