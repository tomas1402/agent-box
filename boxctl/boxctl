VERBOS_NODO = {"estado": op_estado, "suites": op_suites, "limpiar": op_limpiar, "podar": op_podar,
               "caja-reiniciar": op_caja_reiniciar, "mantenimiento": op_mantenimiento, "logs": op_logs,
               "firewall": op_firewall, "gc": op_gc, "salvar": op_salvar}


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(prog="boxctl", description="Box de agentes: contrato v%d" % CONTRATO)
    p.add_argument("--json", action="store_true", help="salida JSON (contrato estable)")
    p.add_argument("--nodo", help="nodo destino (nodos.json); en pool: auto")
    sub = p.add_subparsers(dest="verbo", required=True)
    sub.add_parser("version")
    sub.add_parser("estado")
    sub.add_parser("suites")
    sp = sub.add_parser("limpiar"); sp.add_argument("--aplicar", action="store_true")
    sp = sub.add_parser("podar"); sp.add_argument("path")
    sp = sub.add_parser("caja-reiniciar"); sp.add_argument("--forzar", action="store_true")
    sub.add_parser("mantenimiento")
    sp = sub.add_parser("gc"); sp.add_argument("--aplicar", action="store_true")
    sp.add_argument("--alcance", choices=["memoria", "procesos", "disco", "todo"], default="todo")
    sp = sub.add_parser("salvar"); sp.add_argument("--aplicar", action="store_true")
    sp = sub.add_parser("logs"); sp.add_argument("-n", type=int, default=30)
    sp = sub.add_parser("firewall")
    sp.add_argument("accion", choices=["estado", "aplicar", "confirmar", "quitar", "verificar", "refrescar"])
    sp.add_argument("--deadman", type=int, default=600, help="segundos hasta el auto-rollback (aplicar)")
    sub.add_parser("nodos")
    sp = sub.add_parser("panel")
    sp.add_argument("--servir", action="store_true", help="abre el panel en 127.0.0.1")
    sp.add_argument("--puerto", type=int, default=4319)
    sp.add_argument("--estado-dir", default="", help="directorio de WI de boxd")
    sp = sub.add_parser("worker"); ws = sp.add_subparsers(dest="accion", required=True)
    ws.add_parser("lista")
    al = ws.add_parser("alta")
    al.add_argument("--repo", required=True); al.add_argument("--rama", required=True)
    al.add_argument("--wi"); al.add_argument("--base", default="origin/qa")
    al.add_argument("--aplicar", action="store_true")
    bj = ws.add_parser("baja")
    bj.add_argument("--worktree", required=True); bj.add_argument("--aplicar", action="store_true")
    bj.add_argument("--forzar", action="store_true")
    return p


def es_nodo_local(nombre: str | None) -> bool:
    if not BOX_ENV.exists():
        return False
    if nombre is None:
        return True
    try:
        return leer_env(BOX_ENV)["NODO"] == nombre
    except BoxError:
        return False


def despachar(a, argv: list[str]) -> dict:
    if a.verbo == "version":
        return {"version": VERSION, "contrato": CONTRATO}
    if a.verbo == "nodos":
        return op_nodos(a)
    if a.verbo == "panel":
        return op_panel(a)
    if a.verbo == "worker":
        return op_worker(a)
    # verbo de nodo
    if es_nodo_local(a.nodo):
        if os.geteuid() != 0:
            raise BoxError("permiso", "los verbos de nodo corren con sudo")
        return VERBOS_NODO[a.verbo](a)
    if not a.nodo:
        raise BoxError("operacion_invalida", "este host no es un nodo: pasar --nodo <nombre>")
    if a.verbo == "limpiar":
        return limpiar_desde_mac(a)
    resto, saltar = [], False
    for x in argv:
        if saltar:
            saltar = False
        elif x == "--nodo":
            saltar = True
        elif x != "--json" and not x.startswith("--nodo="):
            resto.append(x)
    return remoto(nodo(a.nodo), resto)


def render(datos, nivel=0) -> str:
    pad = "  " * nivel
    if isinstance(datos, dict):
        out = []
        for k, v in datos.items():
            if isinstance(v, (dict, list)) and v:
                out.append(f"{pad}{k}:")
                out.append(render(v, nivel + 1))
            else:
                out.append(f"{pad}{k}: {v}")
        return "\n".join(out)
    if isinstance(datos, list):
        return "\n".join(render(x, nivel) if isinstance(x, dict) else f"{pad}- {x}" for x in datos)
    return f"{pad}{datos}"


def main(argv: list[str] | None = None) -> int:
    argv = list(sys.argv[1:] if argv is None else argv)
    p = parser()
    try:
        a = p.parse_args(argv)
    except SystemExit as e:
        if "--json" in argv and e.code:
            print(json.dumps({"contrato": CONTRATO, "ok": False,
                              "error": {"codigo": "operacion_invalida", "mensaje": "argumentos invalidos"}}))
        return ERRORES["operacion_invalida"] if e.code else 0
    op = a.verbo + (f" {a.accion}" if getattr(a, "accion", None) and a.verbo == "worker" else "")
    try:
        datos = despachar(a, argv)
    except BoxError as e:
        sobre = {"contrato": CONTRATO, "ok": False, "operacion": op,
                 "error": {"codigo": e.codigo, "mensaje": e.mensaje, "detalle": e.detalle}}
        if a.json:
            print(json.dumps(sobre, ensure_ascii=False))
        else:
            print(f"error [{e.codigo}]: {e.mensaje}", file=sys.stderr)
        return ERRORES[e.codigo]
    except Exception as e:  # noqa: BLE001 - el contrato promete JSON tambien ante lo inesperado
        if a.json:
            print(json.dumps({"contrato": CONTRATO, "ok": False, "operacion": op,
                              "error": {"codigo": "error_interno", "mensaje": f"{type(e).__name__}: {e}"}}))
        else:
            print(f"error [error_interno]: {type(e).__name__}: {e}", file=sys.stderr)
        return ERRORES["error_interno"]
    sobre = {"contrato": CONTRATO, "ok": True, "operacion": op, "datos": datos}
    print(json.dumps(sobre, ensure_ascii=False) if a.json else render(datos))
    return 0


if __name__ == "__main__":
    sys.exit(main())
