#!/usr/bin/env bash
# Guarda o reemplaza un secreto de la caja de agentes. El valor entra por stdin, nunca
# por argumento (no queda en el historial ni en ps). La caja lo toma al proximo
# `boxctl caja-reiniciar` (v2: ya NO borra la caja sola; v1 hacia docker rm -f y mataba a los
# agentes vivos).
#   gh auth token | ssh nodo-a-admin sudo orca-secret-set GH_TOKEN
set -euo pipefail
name=${1:?nombre de la variable}
[[ "$name" =~ ^[A-Z_][A-Z0-9_]*$ ]] || { echo "nombre invalido: $name" >&2; exit 2; }
IFS= read -r value
[ -n "$value" ] || { echo "valor vacio" >&2; exit 2; }
f=/etc/orca-agent/secrets.env
umask 027
touch "$f"
tmp=$(mktemp /etc/orca-agent/.secrets.XXXXXX)
grep -v "^$name=" "$f" > "$tmp" || true
printf '%s=%s\n' "$name" "$value" >> "$tmp"
chown root:agent "$tmp"; chmod 640 "$tmp"
mv "$tmp" "$f"
echo "ok: $name guardado; aplicar con: sudo boxctl caja-reiniciar (rechaza si hay agentes vivos)"
